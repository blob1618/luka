# Meta WhatsApp API Configuration
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here
WHATSAPP_API_TOKEN=your_meta_permanent_or_temporary_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_GRAPH_API_VERSION=v26.0

# Shared only between luka_frontend server and the backend admin API
FLOW_ADMIN_API_KEY=replace_with_a_long_random_value

# LLM Provider Configuration
# Options: gemini, mistral
LLM_PROVIDER=gemini

# LLM Configuration (Gemini)
# Gemini Configuration
# Lista de modelos disponibles actualmente:
# gemini-3.1-pro-preview - Precio($2.00 / $12.00) - Límite de cuota
# gemini-3.1-pro-preview-customtools - Precio($2.00 / $12.00) - Límite de cuota
# gemini-pro-latest - Precio($2.00 / $12.00) - Límite de cuota
# gemini-2.5-pro - Precio($1.25 / $10.00) - No disponible
# gemini-3.5-flash - Precio($1.50 / $9.00) - Latencia Media(6.53s)
# gemini-3.6-flash - Precio($0.75 / $3.75) - Latencia Media(7.28s)
# gemini-3.7-flash - Precio($0.75 / $3.75) - Latencia Media(12.40s)
# gemini-flash-latest - Precio($0.75 / $3.75) - Latencia Media(4.83s)
# gemini-3-flash-preview - Precio($0.50 / $3.00) - Latencia Media(2.91s)
# gemini-3.5-flash-lite - Precio($0.30 / $2.50) - Latencia Media(5.32s)
# gemini-2.5-flash - Precio($0.30 / $2.50) - No disponible
# gemini-flash-lite-latest - Precio($0.25 / $1.50) - Latencia Media(6.28s)
# gemini-3.1-flash-lite - Precio($0.25 / $1.50) - Latencia Media(3.34s) - ⭐
# gemini-3.1-flash-lite-preview - Precio($0.25 / $1.50) - Latencia Media(1.78s) - ⭐
# gemini-2.5-flash-lite - Precio($0.10 / $0.40) - No disponible
# gemma-4-26b-a4b-it - Precio($0.12 / $0.40) - Latencia Media(6.87s)
# gemma-4-31b-it - Precio($0.10 / $0.34) - Latencia Media(7.59s)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Mistral Configuration
# Lista de modelos disponibles actualmente:
# mistral-medium-latest - Precio($1.50 / $7.50) - Latencia Media(0.72s)
# mistral-small-latest - Precio($0.15 / $0.60) - Latencia Media(1.10s) - ⭐
# mistral-large-latest - Precio($0.50 / $1.50) - Latencia Media(0.72s)
# ministral-3b-latest - Precio($0.10 / $0.10) - Latencia Media(0.61s) - ⭐
# ministral-8b-latest - Precio($0.15 / $0.15) - Latencia Media(0.57s)
# ministral-14b-latest - Precio($0.20 / $0.20) - Latencia Media(0.61s)
# zai-glm-5-2 - Precio($1.40 / $4.40) - Latencia Media(0.91s)
# voxtral-small-latest - Precio($0.10 / $0.40) - Latencia Media(0.61s) - Entrada de audio
# labs-leanstral-1-5 - Gratis (Labs) - Requiere habilitación por admin (403 en plan Free)
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# Database Configuration
DATABASE_URL=sqlite:///./luka.db
# For PostgreSQL use something like:
# DATABASE_URL=postgresql://user:password@localhost:5432/luka

# Redis Configuration
# Optional locally. Required/recommended for deployed environments that use Redis-backed features.
REDIS_URL=redis://localhost:6379

# WhatsApp Onboarding Configuration
ONBOARDING_REGISTRATION_URL=http://localhost:8000/registro
ONBOARDING_INVITATION_TTL_MINUTES=30
ONBOARDING_RESEND_COOLDOWN_SECONDS=60
ONBOARDING_MAX_RESENDS=3

# WhatsApp Template for payment reminders (approved by Meta)
WHATSAPP_REMINDER_TEMPLATE_NAME=recordatorio_pago_vencimiento

# Recordatorio proactivo diario: hora local America/Argentina/Buenos_Aires (0-23). Sin esta variable la feature queda apagada.
PROACTIVE_PROMPT_HOUR=20

# WhatsApp Dashboard Login Link Configuration (comando /link para usuarios ya vinculados)
# La URL usa el mismo host que ONBOARDING_REGISTRATION_URL (arriba), con /login
# en vez de /registro — no hace falta configurar el dominio del frontend dos veces.
DASHBOARD_LOGIN_TTL_MINUTES=10
DASHBOARD_LOGIN_RESEND_COOLDOWN_SECONDS=60
DASHBOARD_LOGIN_MAX_RESENDS=3
